# Build output (object files, libsynth.a copies, and the linked binary) is
# reproducible from source via `nice make -j2 all` and must never be
# tracked — this repo has carried real pain from tracked build artifacts
# before; do not repeat it here.
build/

# Direct-launch (Frogg3rs) build output -- app/build-launcher.sh points
# APP_BUILD_DIR here so it lands in our own tree instead of the
# External/Sheaf submodule; reproducible from source, never tracked.
build-launcher/

# Bytecode cached when one check script imports check_common.py. Reproducible,
# machine-specific, and never useful to another reader.
__pycache__/

# Projucer-generated Android Studio/Gradle project (app/android/build-android.sh
# resaves app/android/Frogg3rs.jucer into this directory). Reproducible from
# the .jucer, and Gradle's own build outputs live under it too -- never
# tracked, same reasoning as build/ and build-launcher/ above.
android/Builds/

# Also Projucer-generated by the same --resave (confirmed: deleting this
# directory and re-running Projucer --resave app/android/Frogg3rs.jucer
# recreates it byte-for-byte). It sits beside Builds/ rather than under it
# because Projucer places every exporter's JUCE module glue code at the
# .jucer's own level, but it is exactly as reproducible and machine-specific
# as Builds/ -- never tracked, same reasoning.
android/JuceLibraryCode/
